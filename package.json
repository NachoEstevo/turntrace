{
  "name": "turntrace",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Replay the order of a voice agent's booking decisions.",
  "type": "module",
  "files": [
    "dist/",
    "examples/commit-first.buggy.json",
    "examples/recovery.idempotent.json",
    "examples/lab/commit-race.json",
    "examples/lab/correction.json",
    "examples/lab/customer-agent.mjs",
    "examples/lab/customer-race.json",
    "examples/lab/device-flush.json",
    "examples/lab/epoch-race.json",
    "examples/lab/once-loss.json",
    "examples/lab/opaque.json",
    "examples/lab/post-end.json",
    "examples/lab/premature-ack.trace.json",
    "examples/lab/recovery.json",
    "examples/lab/redelivery.json",
    "examples/lab/reduce.json",
    "docs/architecture.md",
    "docs/adapter.md",
    "docs/acceptance.md",
    "docs/distribution.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "notices/zod-MIT.txt"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "bin": {
    "turntrace": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node scripts/pack-check-dist.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "demo": "node dist/cli/index.js demo",
    "recovery": "node dist/cli/index.js recovery",
    "replay": "node dist/cli/index.js replay"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
